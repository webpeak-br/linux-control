# Exemplo de serviço systemd para o hub. Ajuste caminhos e senha.
# sudo cp deploy/linux-control-hub.service /etc/systemd/system/ && sudo systemctl enable --now linux-control-hub
[Unit]
Description=Linux Control Hub
After=network-online.target

[Service]
User=linuxcontrol
WorkingDirectory=/opt/linux-control-hub
Environment=LCTL_HOST=127.0.0.1
Environment=LCTL_PORT=7420
Environment=LCTL_DATA=/var/lib/linux-control
Environment=LCTL_PUBLIC_URL=https://painel.seudominio.com
Environment=LCTL_TRUST_PROXY=1
EnvironmentFile=-/etc/linux-control-hub.env
ExecStart=/usr/bin/node hub/server.js
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/linux-control

[Install]
WantedBy=multi-user.target
